# Desactivar caché LiteSpeed para archivos JS y CSS
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
</FilesMatch>

# LiteSpeed cache purge
<IfModule LiteSpeed>
    CacheDisable public /js/
    CacheDisable public /css/
</IfModule>
